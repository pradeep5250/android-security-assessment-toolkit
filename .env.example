# Android Security Assessment Toolkit (ASAT)
# Environment Configuration

# Database (SQLite by default, set DATABASE_URL for PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./asat.db
# DATABASE_URL=postgresql+asyncpg://asat:asat_password@localhost:5432/asat_db

# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ADB
ADB_PATH=adb
ADB_TIMEOUT=30

# File Upload
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# App
APP_NAME=Android Security Assessment Toolkit
APP_VERSION=1.0.0
